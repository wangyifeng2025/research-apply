DATABASE_URL=postgres://wangyifeng@127.0.0.1:5432/research_apply_db
SERVER_BIND=127.0.0.1:8080
CORS_ORIGIN=http://localhost:3000
# 每条日志一行。SQL 只保留摘要；需要完整语句时再临时打开 sqlx=debug，语句仍会带换行。
RUST_LOG=info,tower_http=info
JWT_SECRET=please-change-this-secret
COOKIE_SECURE=false
# 附件文件存放目录，相对后端进程的工作目录。正式环境换成绝对路径。
ATTACHMENT_DIR=data/attachments
# 申报书 PDF 使用的中文字体。不设置时依次查找宋体、冬青黑体、Arial Unicode、Noto CJK 和文泉驿。
# Ubuntu 安装 fonts-noto-cjk 后使用下面两行。该字体集序号 2 是简体中文。
# PDF_FONT=/usr/share/fonts/opentype/noto/NotoSerifCJK-Regular.ttc
# PDF_FONT_INDEX=2
